  "author": "hajorda",
  "ai": "yes",
  "version": "0.1.0",
  "style": {
    "chrome": "mod/userChrome.css"
  },
  "preferences": "mod/preferences.json",
  "scripts": {
    "mod/core.uc.js": {
      "include": [
        "chrome://browser/content/browser.xhtml"
      ],
      "loadOrder": 10
    },
    "mod/ai.uc.js": {
      "include": [
        "chrome://browser/content/browser.xhtml"
      ],
      "loadOrder": 11
    },
    "mod/zen-adapter.uc.js": {
      "include": [
        "chrome://browser/content/browser.xhtml"
      ],
      "loadOrder": 12
    },
    "mod/tidy.uc.js": {
      "include": [
        "chrome://browser/content/browser.xhtml"
      ],
      "loadOrder": 13
    }
  },
  "tags": [
